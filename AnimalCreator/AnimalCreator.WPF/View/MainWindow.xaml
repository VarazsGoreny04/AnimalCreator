<Window x:Class="AnimalCreator.WPF.View.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewmodel="clr-namespace:AnimalCreator.WPF.ViewModel"
		d:DataContext="{d:DesignInstance Type=viewmodel:AnimalCreatorViewModel}"
		mc:Ignorable="d"
		Title="AnimalCreator"
		MinWidth="300" Width="800" MinHeight="60" Height="600">
	<Grid>
		<ItemsControl x:Name="DrawArea" ItemsSource="{Binding Shapes}" Width="auto" Height="auto">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<Canvas Background="#145014"
						Width="auto"
						Height="auto"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemContainerStyle>
				<Style TargetType="ContentPresenter">
					<Setter Property="Canvas.Top" Value="0" />
					<Setter Property="Canvas.Left" Value="0" />
				</Style>
			</ItemsControl.ItemContainerStyle>

			<ItemsControl.Resources>
				<DataTemplate DataType="{x:Type viewmodel:PathData}">
					<Path
					Stroke="Black"
					Data="{Binding Geometry}"
					RenderTransform="{Binding Transformations}"
					Fill="{Binding Fill}"
					StrokeStartLineCap="Round"
					StrokeLineJoin="Round"
					StrokeEndLineCap="Round" />
				</DataTemplate>
			</ItemsControl.Resources>
		</ItemsControl>

		<Grid Width="auto" Height="50" VerticalAlignment="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0" Content="Snake" Foreground="#ff1a1a" Command="{Binding ChangeAnimalCommand}" CommandParameter="0" />
			<Button Grid.Column="1" Content="Fish" Foreground="#337dff" Command="{Binding ChangeAnimalCommand}" CommandParameter="1" />
			<Button  Grid.Column="2" Content="Lizard" Foreground="#8cff1a" Command="{Binding ChangeAnimalCommand}" CommandParameter="2" />
			<Button  Grid.Column="3" Content="Pause" Foreground="#f2d49d" Command="{Binding PauseCommand}" />
		</Grid>
	</Grid>
</Window>