<Window x:Class="AnimalCreator.WPF.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewmodel="clr-namespace:AnimalCreator.WPF.ViewModel"
		d:DataContext="{d:DesignInstance Type=viewmodel:AnimalCreatorViewModel}"
		mc:Ignorable="d"
		Title="AnimalCreator" Width="{Binding WindowWidth}" Height="{Binding WindowHeight}">
	<ItemsControl ItemsSource="{Binding Shapes}">
		<ItemsControl.ItemsPanel>
			<ItemsPanelTemplate>
				<Canvas Background="DarkGreen" />
			</ItemsPanelTemplate>
		</ItemsControl.ItemsPanel>

		<ItemsControl.ItemContainerStyle>
			<Style TargetType="ContentPresenter">
				<Setter Property="Canvas.Top"
					Value="0" />

				<Setter Property="Canvas.Left"
					Value="0" />
			</Style>
		</ItemsControl.ItemContainerStyle>

		<ItemsControl.Resources>
			<DataTemplate DataType="{x:Type viewmodel:EllipseData}">
				<Ellipse
					Stroke="Black"
					Width="{Binding Width}"
					Height="{Binding Height}"
					Margin="{Binding Margin}"
					RenderTransform="{Binding Transformations}"
					Fill="{Binding Fill}" />
			</DataTemplate>

			<DataTemplate DataType="{x:Type viewmodel:PathData}">
				<Path
					Stroke="Black"
					Data="{Binding PathFigures}"
					RenderTransform="{Binding Transformations}"
					Fill="{Binding Fill}" />
			</DataTemplate>
		</ItemsControl.Resources>
	</ItemsControl>
</Window>